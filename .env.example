PORT=3000
APP_ORIGIN=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
RATE_LIMIT_PER_MINUTE=120
ADMIN_TOKEN=change-me

# Supabase — server-side only; never expose service-role key to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — server-side only. Use test keys in development and live keys in production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional AI provider (OpenAI-compatible chat completions endpoint).
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# Meta / social integrations — secrets only.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
META_APP_SECRET=
WEBHOOK_VERIFY_TOKEN=
